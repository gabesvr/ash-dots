# fuzzel com rolagem do mouse corrigida (scroll.patch):
# a bolinha rola a lista linha a linha e o item sob o mouse fica selecionado.
# Gerar: cd ~/dots/src/fuzzel && makepkg -sf   → instalar: sudo pacman -U fuzzel-*.pkg.tar.zst
pkgname=fuzzel
pkgver=1.15.0
pkgrel=2
pkgdesc='Application launcher for wlroots based Wayland compositors (scroll patch)'
arch=(x86_64)
url='https://codeberg.org/dnkl/fuzzel'
license=(MIT)
depends=(cairo fcft fontconfig libpng libxkbcommon pixman wayland resvg)
makedepends=(git meson ninja scdoc wayland-protocols tllist)
source=("git+$url.git#tag=$pkgver" scroll.patch)
sha256sums=(SKIP SKIP)

prepare() {
  cd fuzzel
  patch -Np1 -i ../scroll.patch
}

build() {
  arch-meson fuzzel build -Denable-cairo=enabled -Dpng-backend=libpng -Dsvg-backend=resvg
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 fuzzel/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
