+/*
+ * First visible match. Keeps the selected match inside the view, moving the
+ * view as little as possible from where it was last shown.
+ */
+static size_t
+view_first(const struct matches *matches)
+{
+    struct matches *m = (struct matches *)matches;
+    const size_t max = m->max_matches_per_page;
+
+    if (max == 0 || m->match_count <= max) {
+        m->first = 0;
+        return 0;
+    }
+
+    size_t f = m->first;
+    if (m->selected < f)
+        f = m->selected;
+    else if (m->selected >= f + max)
+        f = m->selected - max + 1;
+    if (f > m->match_count - max)
+        f = m->match_count - max;
+
+    m->first = f;
+    return f;
+}
+
+bool
+matches_scroll(struct matches *matches, int lines)
+{
+    const size_t max = matches->max_matches_per_page;
+    if (max == 0 || matches->match_count <= max)
+        return false;
+
+    const size_t f = view_first(matches);
+    const size_t last = matches->match_count - max;
+    size_t nf;
+
+    if (lines < 0)
+        nf = (size_t)-lines > f ? 0 : f - (size_t)-lines;
+    else
+        nf = min(f + (size_t)lines, last);
+
+    if (nf == f)
+        return false;
+
+    matches->first = nf;
+    if (matches->selected < nf)
+        matches->selected = nf;
+    else if (matches->selected >= nf + max)
+        matches->selected = nf + max - 1;
+    return true;
+}
