+/* Scroll the list; the row under the pointer stays selected */
+static bool
+scroll_view(struct seat *seat, int lines)
+{
+    struct wayland *wayl = seat->wayl;
+    if (!matches_scroll(wayl->matches, lines))
+        return false;
+
+    ssize_t row = render_get_row_num(
+        wayl->render, wayl->width, seat->pointer.x, seat->pointer.y,
+        wayl->matches);
+    if (row >= 0)
+        matches_idx_select(wayl->matches, row);
+    return true;
+}
